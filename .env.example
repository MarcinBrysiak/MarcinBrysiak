# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required. Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# ─── Application ──────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development

# debug | info | warning | error
LOG_LEVEL=info

# ─── LLM defaults ─────────────────────────────────────────────────────────────
# Default model for agents. Override per-agent if needed.
# Options: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5
DEFAULT_MODEL=claude-opus-4-6

# Max tokens for standard agent responses
DEFAULT_MAX_TOKENS=4096

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable. All flags off by default in development.
FEATURE_CONTENT_WRITER=true
FEATURE_CAMPAIGN_ANALYST=false
FEATURE_LEAD_SCORER=false
FEATURE_AGENT_MONITOR_DASHBOARD=true

# ─── Integrations (fill in when connecting real systems) ──────────────────────
# CRM
# HUBSPOT_API_KEY=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# Analytics
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Streamlit server settings
STREAMLIT_PORT=8501
